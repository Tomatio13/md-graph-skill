# Repo GraphRAG skill-local environment template
# Copy the values you need into the repository root `.env` when installing this skill.

# Required provider selection
GRAPH_CREATE_PROVIDER=anthropic
GRAPH_ANALYSIS_PROVIDER=anthropic

# Required provider credential
ANTHROPIC_API_KEY=your_anthropic_api_key

# Required model names
GRAPH_CREATE_MODEL_NAME=claude-haiku-4-5
GRAPH_ANALYSIS_MODEL_NAME=claude-sonnet-4-5

# Common optional settings
EMBEDDING_MODEL_NAME=voyageai/voyage-4-nano
EMBEDDING_DIM=1024
EMBEDDING_MAX_TOKEN_SIZE=2048
SEARCH_MODE=mix
SEARCH_TOP_K=40
PARALLEL_NUM=3
MARKDOWN_CHUNK_MAX_HEADING_LEVEL=2

# Optional OpenAI-compatible endpoint example
# OPENAI_BASE_URL=http://localhost:1234/v1

# Notes
# - `query` and `plan` require an existing storage
# - if you change `EMBEDDING_MODEL_NAME`, recreate storage
# - if you omit `--markdown-chunk-heading-level`, `MARKDOWN_CHUNK_MAX_HEADING_LEVEL` is used
# - `MARKDOWN_CHUNK_MAX_HEADING_LEVEL` must be `2` or `3`
# - see `references/configuration.md` for more details
